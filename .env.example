# Supabase — obrigatório para produção
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_KEY=SEU_ANON_KEY
SUPABASE_DB_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJECT_REF.supabase.co:5432/postgres

# 99Food — necessário para polling automático
FOOD99_API_URL=https://api.99food.com.br/v1
FOOD99_API_KEY=SUA_CHAVE_99FOOD
FOOD99_STORE_ID=SEU_ID_DE_LOJA

# iFood
IFOOD_CLIENT_ID=SEU_CLIENT_ID
IFOOD_CLIENT_SECRET=SEU_CLIENT_SECRET
IFOOD_MERCHANT_ID=SEU_MERCHANT_ID

# Polling
POLLING_INTERVAL_SECONDS=300
POLLING_ENABLED=false

# Ambiente: development = SQLite | production = Supabase
ENVIRONMENT=development
